# 新闻同步专用。复制为 .env 后填写；勿与仓库根目录 server/.env 混用。

# 融媒网关
GATEWAY_LOGIN_URL=https://gateway.ewdcloud.com/shwk/EfBT8TYwkGfReSKx/login
GATEWAY_QUERY_URL=https://gateway.ewdcloud.com/bi/api/ods/query
GATEWAY_USERNAME=
GATEWAY_PASSWORD=

# district=mediaType+mediaLevels（例：全市 上海市）；street=按街镇 LOCATIONS
QUERY_MODE=district
MEDIA_TYPES=融媒APP
# 行政/层级筛选：留空=不按 mediaLevels 过滤（推荐与融媒APP 同用）。
# 若填「上海市」且与 MEDIA_TYPES 组合后接口返回 0 条，请向网关方确认枚举值或留空 MEDIA_LEVELS。
MEDIA_LEVELS=
# LOCATIONS=广中路街道

SYNC_DAYS=7
PAGE_SIZE=50
MAX_PAGES=50

# 首次同步（本地 synced_ids 为空）时：默认只拉「今日 00:00 ~ 当前时间」，确保当天有稿进库。设为 0 则首次也按 SYNC_DAYS。
# FIRST_SYNC_TODAY_ONLY=1

# 未设置时进程内默认 Asia/Shanghai（与 run-cron.sh 一致）
# TZ=Asia/Shanghai

# Coze
COZE_API_TOKEN=
COZE_DATASET_ID=
# COZE_SPACE_ID=
# 自定义分段：单段最大 token（过小会在一篇内再切碎）。默认 32000
# CHUNK_MAX_TOKENS=32000

# 仅 npm run setup 使用：crontab 五段式，默认每天 8:00 执行 run-cron.sh
# CRON_SCHEDULE=0 8 * * *
