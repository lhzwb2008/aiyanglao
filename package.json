{
  "name": "knowledge-graph-explorer",
  "version": "2.0.0",
  "description": "知识图谱抽取与3D可视化展示",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install && cd ../news-sync-service && npm install",
    "build": "cd client && npm run build",
    "news-sync": "cd news-sync-service && npm run sync",
    "news-sync:setup": "cd news-sync-service && npm run setup",
    "news-sync:purge-and-resync": "cd news-sync-service && npm run purge-and-resync",
    "news-sync:clear-synced-ids": "cd news-sync-service && npm run clear-synced-ids",
    "purge-and-resync": "cd news-sync-service && npm run purge-and-resync",
    "clear-synced-ids": "cd news-sync-service && npm run clear-synced-ids"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
